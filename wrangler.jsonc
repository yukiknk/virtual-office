{
	// ── 本番（トップレベル） ──
	// デプロイ: npm run deploy        → virtual-office
	"name": "virtual-office",
	"main": "src/index.js",
	"compatibility_date": "2026-08-01",
	// ログを Cloudflare に残す（ダッシュボードの Observability で見られる。ベータにも引き継がれる）。
	// 部屋が作り直される原因を調べるために入れた。残るのは console.log の行と、捕まえられなかった例外。
	// invocation_logs を false にしているのは、位置のメッセージ1通ごとに1件残ると、
	// 無料枠（1日20万件）をすぐ使い切るため。
	"observability": {
		"enabled": true,
		"logs": {
			"invocation_logs": false
		}
	},
	"assets": {
		"directory": "./public"
	},
	"kv_namespaces": [
		{
			"binding": "LAYOUT_KV",
			"id": "6d39c872a27b4bb2a8c7e9a5932aa571"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "ROOM",
				"class_name": "Room"
			}
		]
	},
	"migrations": [
		{
			// 旧クラス OfficeRoom の削除は本番で適用済み。
			// ローカルの初回起動では OfficeRoom が存在せず失敗するため、タグだけ残して中身は空にする。
			"tag": "v2"
		},
		{
			"tag": "v3",
			"new_sqlite_classes": [
				"Room"
			]
		}
	],
	// ── ベータ（テスト環境） ──
	// デプロイ: npm run deploy:beta   → virtual-office-beta
	// 本番とは別の Worker・別の KV・別の Durable Object になるため、
	// ここで何をしても本番のデータには一切触れません。
	//
	// バインディング（kv_namespaces / durable_objects）と vars・secrets は
	// トップレベルから継承されないため、環境ごとに書き直す必要があります。
	// main / assets / compatibility_date / migrations は継承されます。
	"env": {
		"beta": {
			// 毎日 3:00（日本時間）に、本番のマップをベータへ写す（src/index.js の scheduled）。
			// 本番の Worker へは services の PROD でつなぐ（読み出しだけ）。BETA.md の「本番のマップを毎日写す」
			"triggers": {
				"crons": ["0 18 * * *"]
			},
			"services": [
				{
					"binding": "PROD",
					"service": "virtual-office"
				}
			],
			"kv_namespaces": [
				{
					"binding": "LAYOUT_KV",
					// ↓ `npm run kv:create-beta` で作った id に差し替えてください
					"id": "c8574a6039d64d6d8199286a4dd7e96b",
					"remote": true
				}
			],
			"durable_objects": {
				"bindings": [
					{
						"name": "ROOM",
						"class_name": "Room"
					}
				]
			}
		}
	}
}